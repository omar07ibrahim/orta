PORT=5000
NODE_ENV=development
JWT_SECRET=
ORTA_DB_PATH=./orta-study.db
# Comma-separated exact HTTP origins; browser cross-origin access is off when empty.
ORTA_ALLOWED_ORIGINS=
ORTA_SEED_DEMO_USERS=false

# Required only when ORTA_SEED_DEMO_USERS=true:
# ORTA_DEMO_ADMIN_PASSWORD=
# ORTA_DEMO_SALES_PASSWORD=
